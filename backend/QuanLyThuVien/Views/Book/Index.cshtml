@model QuanLyThuVien.ViewModels.SachViewModel
@{
    ViewBag.Title = "Quản lý Sách";
    Layout = "~/Views/Layout/LayoutNguoiDung.cshtml";
}

@Html.Action("HeaderPartialView", "Admin")

<div class="admin-container">
    @Html.Action("SidebarPartiView", "Admin")

    <main class="admin-main-content">
        <h1><i class="fas fa-book"></i> Quản lý Sách</h1>

        <div class="toolbar">
            <input type="text" class="search-input" placeholder="Tìm kiếm theo tên sách, tác giả...">
            <button id="add-book-btn" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm Sách Mới</button>
        </div>

        <section class="data-table-section">
            <table id="sach-table">
                <thead>
                    <tr>
                        <th>Mã Sách</th>
                        <th>Tên Sách</th>
                        <th>Tác Giả</th>
                        <th>Số Lượng Tồn</th>
                        <th>Nhà Xuất Bản</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DanhSachSach)
                    {
                        <tr>
                            <td>@item.MaSach</td>
                            <td>@item.TenSach</td>
                            <td>@(item.TacGia?.TenTacGia)</td>
                            <td>@item.SoLuongTon</td>
                            <td>@(item.NhaXuatBan?.TenNXB)</td>
                            <td class="action-buttons">
                                <button class="btn btn-edit" data-id="@item.MaSach" title="Chỉnh sửa"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-delete" data-id="@item.MaSach" title="Xóa"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- MODAL ĐỂ THÊM/SỬA SÁCH (Đã cập nhật để nhận dữ liệu động) -->
<div id="book-modal" class="modal">
    <div class="modal-content large">
        <span class="close-book-modal">&times;</span>
        <h2 id="book-modal-title">Thêm Sách Mới</h2>

        @* Quan trọng: Form sẽ được gửi bằng AJAX *@
    <form id="book-form">
        <input type="hidden" id="ma-sach-modal" name="MaSach" />
        <div class="form-row">
            <div class="form-group">
                <label for="ten-sach-modal">Tên Sách:</label>
                <input type="text" id="ten-sach-modal" name="TenSach" required>
            </div>
            <div class="form-group">
                <label for="so-luong">Số Lượng Tồn:</label>
                <input type="number" id="so-luong" name="SoLuongTon" required min="0">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                @* Sẽ cần thêm chức năng tìm kiếm/thêm tác giả sau *@
                <label for="tac-gia">Tác Giả (Nhập Mã Tác giả):</label>
                <input type="number" id="tac-gia" name="MaTacGia" required>
            </div>
            <div class="form-group">
                <label for="nxb">Nhà Xuất Bản:</label>
                @Html.DropDownList("MaNXB", Model.DanhSachNXB, "-- Chọn NXB --", new { @class = "form-control", id = "nxb", required = "required" })
            </div>
        </div>
        <div class="form-row">
            <div class="form-group full-width">
                <label for="the-loai">Thể Loại:</label>
                @* Quan trọng: name="selectedTheLoaiIds" phải khớp với tham số trong Action Create *@
                @Html.ListBox("selectedTheLoaiIds", new MultiSelectList(Model.DanhSachTheLoai, "Value", "Text"), new { id = "the-loai", @class = "form-control", multiple = "multiple", required = "required" })
            </div>
        </div>
        <div class="form-group">
            <label for="mo-ta">Mô Tả Ngắn:</label>
            <textarea id="mo-ta" name="MoTa" rows="4"></textarea>
        </div>
        <button type="submit" class="submit-btn">Lưu Lại</button>
    </form>
    </div>
</div>

@Html.Partial("_FooterPartial")