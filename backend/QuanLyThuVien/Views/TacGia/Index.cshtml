@model IEnumerable<QuanLyThuVien.Models.TacGia>
@{
    ViewBag.Title = "Quản lý Tác giả";
    Layout = "~/Views/Layout/LayoutNguoiDung.cshtml";
}

@Html.Action("HeaderPartialView", "Admin")

<div class="admin-container">
    @Html.Action("SidebarPartiView", "Admin")

    <main class="admin-main-content">
        <h1><i class="fas fa-user-pen"></i> Quản lý Tác giả</h1>
        <div class="toolbar">
            <input type="text" id="author-search-input" class="search-input" placeholder="Tìm kiếm theo tên tác giả...">
            <button id="add-author-btn" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm Tác giả Mới</button>
        </div>

        <section class="data-table-section">
            <table id="author-table">
                @* Thêm ID cho bảng *@
                <thead>
                    <tr>
                        <th>Mã Tác giả</th>
                        <th>Tên Tác giả</th>
                        <th>Tiểu sử/Liên hệ</th>
                        <th style="width: 150px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @* Dùng vòng lặp để hiển thị dữ liệu động từ Model *@
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaTacGia</td>
                            <td>@item.TenTacGia</td>
                            <td>@item.TieuSu</td>
                            <td class="action-buttons">
                                @* THÊM data-id VÀO CÁC NÚT *@
                                <button class="btn btn-edit" title="Chỉnh sửa" data-id="@item.MaTacGia"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-delete" title="Xóa" data-id="@item.MaTacGia"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal cho Tác giả (ĐÃ SỬA LẠI NAME) -->
<div id="author-modal" class="modal">
    <div class="modal-content large">
        <span class="close-author-modal">&times;</span>
        <h2 id="author-modal-title">Thêm Tác giả Mới</h2>
        <form id="author-form">
            <input type="hidden" id="ma-tac-gia" name="MaTacGia" />

            <div class="form-group">
                <label for="ten-tac-gia">Tên Tác giả:</label>
                <input type="text" id="ten-tac-gia" name="TenTacGia" class="form-control" required>
            </div>
            <div class="form-group">
                <label for="tieu-su">Tiểu sử/Thông tin liên hệ:</label>
                <textarea id="tieu-su" name="TieuSu" class="form-control" rows="4"></textarea>
            </div>
            <div class="form-buttons" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Lưu Lại</button>
            </div>
        </form>
    </div>
</div>

@Html.Partial("_FooterPartial")