@model IEnumerable<QuanLyThuVien.Models.NhaXuatBan>
@{
    ViewBag.Title = "Quản lý Nhà Xuất Bản";
    Layout = "~/Views/Layout/LayoutNguoiDung.cshtml";
}

@Html.Action("HeaderPartialView", "Admin")

<div class="admin-container">
    @Html.Action("SidebarPartiView", "Admin")

    <main class="admin-main-content">
        <h1><i class="fas fa-building"></i> Quản lý Nhà Xuất Bản</h1>
        <div class="toolbar">
            @* Sửa lại input tìm kiếm để dùng với JavaScript *@
            <input type="text" id="nxb-search-input" class="search-input" placeholder="Tìm kiếm theo tên NXB...">
            <button id="add-nxb-btn" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm NXB Mới</button>
        </div>

        <section class="data-table-section">
            <table id="nxb-table">
                @* Thêm ID cho bảng *@
                <thead>
                    <tr>
                        <th>Mã NXB</th>
                        <th>Tên Nhà Xuất Bản</th>
                        <th>Địa chỉ</th>
                        <th>Email</th>
                        <th style="width: 150px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaNXB</td>
                            <td>@item.TenNXB</td>
                            <td>@item.DiaChi</td>
                            <td>@item.Email</td>
                            <td class="action-buttons">
                                @* THÊM data-id VÀO CÁC NÚT *@
                                <button class="btn btn-edit" title="Chỉnh sửa" data-id="@item.MaNXB"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-delete" title="Xóa" data-id="@item.MaNXB"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal cho NXB (ĐÃ SỬA LẠI NAME) -->
<div id="nxb-modal" class="modal">
    <div class="modal-content large">
        <span class="close-nxb-modal">&times;</span>
        <h2 id="nxb-modal-title">Thêm Nhà Xuất Bản Mới</h2>
        <form id="nxb-form">
            @* Thêm input ẩn để lưu MaNXB khi sửa, nhưng ở đây dùng chung 1 input và khóa lại là được *@
            <input type="hidden" name="MaNXB" id="ma-nxb-hidden" />

            <div class="form-group">
                <label for="ten-nxb">Tên Nhà Xuất Bản:</label>
                <input type="text" id="ten-nxb" name="TenNXB" class="form-control" required>
            </div>
            <div class="form-group">
                <label for="dia-chi">Địa chỉ:</label>
                <input type="text" id="dia-chi" name="DiaChi" class="form-control">
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="sdt-nxb">Số điện thoại:</label>
                    <input type="tel" id="sdt-nxb" name="SoDienThoai" class="form-control">
                </div>
                <div class="form-group">
                    <label for="email-nxb">Email:</label>
                    <input type="email" id="email-nxb" name="Email" class="form-control">
                </div>
            </div>
            <div class="form-buttons" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Lưu Lại</button>
            </div>
        </form>
    </div>
</div>

@Html.Partial("_FooterPartial")