@model QuanLyThuVien.ViewModels.XuLyViPhamPageViewModel
@{
    ViewBag.Title = "Xử lý Vi phạm";
    Layout = "~/Views/Layout/LayoutNguoiDung.cshtml";
}

@Html.Action("HeaderPartialView", "Admin")

<div class="admin-container">
    @Html.Action("SidebarPartiView", "Admin")

    <main class="admin-main-content">
        <h1><i class="fas fa-gavel"></i> Xử lý Vi phạm</h1>

        <div class="toolbar">
            <div class="search-filter-group">
                <input type="text" id="violation-search-input" class="search-input" placeholder="Tìm kiếm...">
                <select id="violation-filter-status" class="filter-status">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="Chưa thanh toán">Chưa thanh toán</option>
                    <option value="Đã thanh toán">Đã thanh toán</option>
                </select>
            </div>
            <button id="add-violation-btn" class="btn btn-primary"><i class="fas fa-plus"></i> Lập Phiếu Phạt</button>
        </div>

        <section class="data-table-section">
            <table id="violation-table">
                <thead>
                    <tr>
                        <th>Mã Vi Phạm</th>
                        <th>Tên Độc Giả</th>
                        <th>Loại Vi Phạm</th>
                        <th>Số Tiền Phạt</th>
                        <th>Ngày Ghi Nhận</th>
                        <th>Trạng Thái</th>
                        <th style="width: 200px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DanhSachViPham)
                    {
                        <tr>
                            <td>@item.MaViPham</td>
                            <td>@item.TenDocGia</td>
                            <td>@item.LoaiViPham</td>
                            <td>@item.SoTienPhat</td>
                            <td>@item.NgayGhiNhan.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "Đã thanh toán")
                                {<span class="status paid">Đã thanh toán</span> }
                                else
                                { <span class="status unpaid">Chưa thanh toán</span>}
                            </td>
                            <td class="action-buttons">
                                @if (item.TrangThai == "Chưa thanh toán")
                                {
                                    <button class="btn btn-success btn-mark-paid" data-id="@item.MaViPhamRaw"><i class="fas fa-check"></i> Đã trả</button>
                                    <button class="btn btn-warning btn-edit" title="Chỉnh sửa" data-id="@item.MaViPhamRaw"><i class="fas fa-edit"></i></button>
                                }
                                <button class="btn btn-delete" title="Xóa" data-id="@item.MaViPhamRaw"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal cho Vi phạm/Phạt -->
<div id="violation-modal" class="modal">
    <div class="modal-content large">
        <span class="close-violation-modal">&times;</span>
        <h2 id="violation-modal-title">Lập Phiếu Phạt Mới</h2>
        <form id="violation-form">
            <input type="hidden" name="MaViPham" />
            <div class="form-row">
                <div class="form-group">
                    <label>Mã Vi Phạm:</label>
                    <input type="text" class="form-control" readonly placeholder="Tự động tạo">
                </div>
                <div class="form-group">
                    <label for="doc-gia-vp">Độc Giả:</label>
                    @Html.DropDownList("MaDocGia", Model.DanhSachDocGia, "-- Chọn độc giả --", new { @class = "form-control", id = "doc-gia-vp", required = "required" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="loai-vi-pham">Loại Vi Phạm:</label>
                    <select id="loai-vi-pham" name="LoaiViPham" class="form-control" required>
                        <option value="Trả sách quá hạn">Trả sách quá hạn</option>
                        <option value="Làm hỏng sách">Làm hỏng sách</option>
                        <option value="Làm mất sách">Làm mất sách</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="so-tien-phat">Số Tiền Phạt (VNĐ):</label>
                    <input type="number" id="so-tien-phat" name="HinhThucPhat" class="form-control" required>
                </div>
            </div>   
            <div class="form-buttons" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Lưu Phiếu Phạt</button>
            </div>
        </form>
    </div>
</div>

@Html.Partial("_FooterPartial")