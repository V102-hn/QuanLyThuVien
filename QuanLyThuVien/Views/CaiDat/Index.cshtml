@model QuanLyThuVien.ViewModels.CaiDatViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Layout/LayoutNguoiDung.cshtml";
}

<!-- ======================= PHẦN GIAO DIỆN CHUNG (ĐÃ BỔ SUNG ĐẦY ĐỦ) ======================= -->
@Html.Action("HeaderPartialView", "Admin")
<!-- ===================== KẾT THÚC PHẦN GIAO DIỆN CHUNG ===================== -->

<div class="admin-container">
    @Html.Action("SidebarPartiView", "Admin")

    <main class="admin-main-content">
        <h1><i class="fas fa-cog"></i> Cài đặt Hệ thống & Quy định</h1>

        <!-- Hiển thị thông báo thành công (nếu có) -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="padding: 15px; background-color: #d4edda; border-color: #c3e6cb; color: #155724; margin-bottom: 20px; border-radius: 5px;">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Sử dụng Html.BeginForm để tạo form và gửi dữ liệu về action POST -->
        @using (Html.BeginForm("Index", "CaiDat", FormMethod.Post, new { id = "settings-form", @class = "settings-container" }))
        {
            @Html.AntiForgeryToken() <!-- Token chống tấn công CSRF -->

            <section class="settings-section">
                <h3>Quy định Mượn/Trả</h3>
                <div class="form-group">
                    <label for="SoNgayMuonToiDa">Số ngày mượn tối đa cho một cuốn sách:</label>
                    @Html.TextBoxFor(m => m.SoNgayMuonToiDa, new { @class = "form-control", type = "number" })
                    <p class="setting-description">Số ngày độc giả được phép giữ sách trước khi bị tính là quá hạn.</p>
                </div>
                <div class="form-group">
                    <label for="SoSachMuonToiDa">Số lượng sách tối đa một độc giả được mượn cùng lúc:</label>
                    @Html.TextBoxFor(m => m.SoSachMuonToiDa, new { @class = "form-control", type = "number" })
                    <p class="setting-description">Giới hạn số lượng sách một độc giả có thể mượn trong một thời điểm.</p>
                </div>
                <div class="form-group">
                    <label for="TienPhatMoiNgay">Tiền phạt cho mỗi ngày trả sách muộn (VNĐ):</label>
                    @Html.TextBoxFor(m => m.TienPhatMoiNgay, new { @class = "form-control", type = "number" })
                    <p class="setting-description">Số tiền phạt sẽ được tính cho mỗi cuốn sách bị trả muộn, nhân với số ngày quá hạn.</p>
                </div>
            </section>

            <section class="settings-section">
                <h3>Thông tin Thư viện</h3>
                <div class="form-group">
                    <label for="TenThuVien">Tên thư viện:</label>
                    @Html.TextBoxFor(m => m.TenThuVien, new { @class = "form-control" })
                    <p class="setting-description">Tên này sẽ hiển thị trên các trang công khai và phiếu in.</p>
                </div>
                <div class="form-group">
                    <label for="DiaChiThuVien">Địa chỉ:</label>
                    @Html.TextBoxFor(m => m.DiaChiThuVien, new { @class = "form-control" })
                </div>
            </section>

            <div class="form-buttons" style="justify-content: flex-end; margin-left: 0;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Thay đổi</button>
            </div>
        }
    </main>
</div>

<!-- ======================= FOOTER (ĐÃ BỔ SUNG) ======================= -->
<footer>
