    <!-- ======================= KẾT THÚC PHẦN TÁI SỬ DỤNG ======================= -->

    <div class="container">
        <!-- === CỘT NỘI DUNG CHÍNH === -->
        <main>
            <div class="search-results-header">
                <h3>Kết quả tìm kiếm cho từ khóa: "<span>Clean Code</span>"</h3>
                <p>Tìm thấy 2 kết quả phù hợp.</p>
            </div>

            <!-- === DANH SÁCH KẾT QUẢ === -->
            <div class="results-list">
                <!-- Mẫu 1 cuốn sách -->
                <div class="book-card">
                    <img class="book-card-image" src="img/cleancode.jpg" alt="Clean Code">
                    <div class="book-card-content">
                        <h4><a href="#">Clean Code</a></h4>
                        <p class="author">Tác giả: Robert C. Martin</p>
                        <p class="description">
                            Cẩm nang về cách viết mã sạch, dễ đọc và dễ bảo trì, một cuốn sách không thể thiếu cho bất kỳ lập trình viên chuyên nghiệp nào.
                        </p>
                        <div class="book-card-status available">
                            <i class="fas fa-check-circle"></i> Có sẵn
                        </div>
                    </div>
                </div>

                <!-- Mẫu 1 cuốn sách khác -->
                <div class="book-card">
                    <img class="book-card-image" src="img/the_clean_.jpg" alt="The Clean Coder">
                    <div class="book-card-content">
                        <h4><a href="#">The Clean Coder: A Code of Conduct for Professional Programmers</a></h4>
                        <p class="author">Tác giả: Robert C. Martin</p>
                        <p class="description">
                            Cuốn sách về quy tắc ứng xử cho các lập trình viên chuyên nghiệp, tập trung vào kỷ luật, trách nhiệm và đạo đức nghề nghiệp.
                        </p>
                        <div class="book-card-status unavailable">
                            <i class="fas fa-times-circle"></i> Đã được mượn hết
                        </div>
                    </div>
                </div>

                <!-- Trường hợp không tìm thấy kết quả (bỏ comment để sử dụng) -->
                <!--
                <div class="no-results">
                    <i class="fas fa-search" style="font-size: 40px; color: #ccc;"></i>
                    <h4 style="margin-top: 20px;">Không tìm thấy kết quả nào</h4>
                    <p>Vui lòng thử lại với một từ khóa khác hoặc kiểm tra lại chính tả.</p>
                </div>
                -->
