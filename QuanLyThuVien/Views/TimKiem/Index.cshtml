                        <li><label><input type="checkbox" name="publisher" value="4"> Alpha Books</label></li>
                    </ul>
                </div>
            </div>

            <!-- Tái sử dụng các box khác từ trang chủ -->
            <div class="sidebar-box">
                <h5>DANH MỤC SÁCH MỚI</h5>
