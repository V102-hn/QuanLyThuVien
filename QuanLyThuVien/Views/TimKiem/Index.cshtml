                    <strong>Theo Chuyên ngành:</strong>
                    <ul>
                        <li><label><input type="checkbox" name="category" value="1"> Công nghệ thông tin</label></li>
                        <li><label><input type="checkbox" name="category" value="3"> Kỹ năng sống</label></li>
                    </ul>
                    <strong style="margin-top: 15px; display: block;">Theo Nhà xuất bản:</strong>
                    <ul>
