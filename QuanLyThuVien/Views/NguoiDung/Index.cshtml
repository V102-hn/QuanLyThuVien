@model IEnumerable<QuanLyThuVien.Models.ThuThu>
@{
    ViewBag.Title = "Quản lý Người dùng";
    Layout = "~/Views/Layout/LayoutNguoiDung.cshtml";
}

@Html.Action("HeaderPartialView", "Admin")

<div class="admin-container">
    @Html.Action("SidebarPartiView", "Admin")

    <main class="admin-main-content">
        <h1><i class="fas fa-user-shield"></i> Quản lý Người dùng Hệ thống</h1>

        <div class="toolbar">
            <input type="text" id="user-search-input" class="search-input" placeholder="Tìm kiếm theo tên đăng nhập, email...">
            <button id="add-user-btn" class="btn btn-primary"><i class="fas fa-user-plus"></i> Thêm Người dùng Mới</button>
        </div>

        <section class="data-table-section">
            <table id="users-table">
                @* Thêm ID cho bảng *@
                <thead>
                    <tr>
                        <th>Tên Đăng Nhập</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng Thái</th>
                        <th style="width: 150px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@user.HoTen</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.IsAdmin == true)
                                {<span class="role admin">Admin</span> }
                                else
                                { <span class="role librarian">Thủ thư</span>}
                            </td>
                            <td>
                                @if (user.DaXoa == true)
                                {<span class="status locked-card">Bị khóa</span> }
                                else
                                { <span class="status active-card">Hoạt động</span>}
                            </td>
                            <td class="action-buttons">
                                @* THÊM data-id VÀO CÁC NÚT *@
                                <button class="btn btn-edit" title="Chỉnh sửa" data-id="@user.MaThuThu"><i class="fas fa-edit"></i></button>
                                @if (user.IsAdmin != true)
                                {
                                    <button class="btn btn-delete" title="Xóa" data-id="@user.MaThuThu"><i class="fas fa-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- MODAL THÊM/SỬA NGƯỜI DÙNG (ĐÃ SỬA LẠI NAME) -->
<div id="user-modal" class="modal">
    <div class="modal-content large">
        <span class="close-user-modal">&times;</span>
        <h2 id="user-modal-title">Thêm Người dùng Mới</h2>
        <form id="user-form">
            <input type="hidden" id="ma-thu-thu" name="MaThuThu" />

            <div class="form-row">
                <div class="form-group">
                    <label for="username">Tên đăng nhập:</label>
                    <input type="text" id="username" name="Username" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="full-name">Họ và Tên:</label>
                    <input type="text" id="full-name" name="HoTen" class="form-control" required>
                </div>
            </div>
            <div class="form-group">
                <label for="email-user">Email:</label>
                <input type="email" id="email-user" name="Email" class="form-control" required>
            </div>
            <div class="form-group">
                <label for="password-user">Mật khẩu (để trống nếu không đổi):</label>
                <input type="password" id="password-user" name="password_user" class="form-control">
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="role-select">Vai trò:</label>
                    <select id="role-select" name="IsAdmin" class="form-control" required>
                        <option value="false">Thủ thư</option>
                        <option value="true">Admin</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="status-select">Trạng Thái:</label>
                    <select id="status-select" name="DaXoa" class="form-control" required>
                        <option value="false">Hoạt động</option>
                        <option value="true">Bị khóa</option>
                    </select>
                </div>
            </div>
            <div class="form-buttons" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Lưu Lại</button>
            </div>
        </form>
    </div>
</div>

@Html.Partial("_FooterPartial")